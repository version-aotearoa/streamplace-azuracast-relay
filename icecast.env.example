# AzuraCast live-source (Icecast/Liquidsoap harbor) credentials.
# Copy to /etc/streamplace/icecast.env on the VPS and chmod 600.
# Relay pushes from the same box, so host stays loopback.

ICECAST_HOST=127.0.0.1
ICECAST_PORT=8005
ICECAST_MOUNT=/
ICECAST_USER=relay
ICECAST_PASSWORD=replace-me
ICECAST_BITRATE=256k
